[Unit]
Description=Publish fgos.pro blog to Telegram (%i)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/docker exec pedagogy_web php /var/www/html/cron/publish-blog-telegram.php --send --queue=%i
TimeoutStartSec=360
