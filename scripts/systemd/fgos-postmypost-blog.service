[Unit]
Description=Publish fgos.pro blog through Postmypost to VK
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/docker exec pedagogy_web php /var/www/html/cron/publish-blog-postmypost.php --send
TimeoutStartSec=infinity
